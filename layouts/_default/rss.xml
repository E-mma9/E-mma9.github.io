{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if eq .Section "posts" }}{{ site.Title }} — Blog{{ else if eq .Section "projects" }}{{ site.Title }} — Projects{{ else }}{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with .Description }}{{ . }}{{ else }}{{ site.Params.description }}{{ end }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang | default "en" }}</language>
    {{ with site.Params.author -}}
    <managingEditor>{{ $.Site.Params.email }} ({{ . }})</managingEditor>
    <webMaster>{{ $.Site.Params.email }} ({{ . }})</webMaster>
    <copyright>© {{ now.Year }} {{ . }}</copyright>
    {{- end }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with $.Site.Params.author -}}
      <author>{{ $.Site.Params.email }} ({{ . }})</author>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Params.summary }}{{ . }}{{ else }}{{ .Summary | plainify }}{{ end }}</description>
      <content:encoded><![CDATA[{{ .Content }}]]></content:encoded>
      {{ range .Params.tags }}
      <category>{{ . }}</category>
      {{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
